 	 }
        
        closedir(dir_stream);
@@ -325,23 +325,36 @@ int inotify_check(time_t now)
 
 			/* Is this is a deletion event? */
 			if (in->mask & IN_DELETE)
-			  my_syslog(LOG_INFO, _("inotify: %s removed"), ah->fname);
-			else 
+			  {
+			    my_syslog(LOG_INFO, _("inotify: %s removed"), ah->fname);
