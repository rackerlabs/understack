 			if (removed > 0)
 			  my_syslog(LOG_INFO, _("inotify: flushed %u names read from %s"), removed, ah->fname);
-			
+
 			/* (Re-)load hostsfile only if this event isn't triggered by deletion */
 			if (!(in->mask & IN_DELETE))
-			  read_hostsfile(ah->fname, ah->index, 0, NULL, 0);
+			  {
