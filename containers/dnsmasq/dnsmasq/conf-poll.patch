 	       if ((ah = dyndir_addhosts(dd, ent->d_name)) &&
 		   stat(ah->fname, &buf) != -1 && S_ISREG(buf.st_mode))
-		 total_size = read_hostsfile(ah->fname, ah->index, total_size, rhash, revhashsz);
+		 {
